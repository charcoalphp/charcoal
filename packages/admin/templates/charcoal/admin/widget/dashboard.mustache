{{!--
Dashboard Widget
================

`charcoal/admin/widget/dashboard`

This widget expects a `Charcoal\Admin\Widget\Dashboard` model as context.

--}}
<div class="dashboard{{# ident }} dashboard-{{ . }}{{/ ident }}">

    {{# widgets }}
        {{# dashboardLayout }}
            {{> charcoal/admin/widget/layout.start }}
        {{/ dashboardLayout }}

        <div class="widget{{# ident }} widget-{{ . }}{{/ ident }}{{# dashboardLayout.cellSpanBy12 }} col-md-{{ . }}{{/ dashboardLayout.cellSpanBy12 }}">

            {{# showHeader }}
                <header class="o-header -small">
                    {{# showTitle }}
                        <h3>{{ title }}</h3>
                    {{/ showTitle }}
                    {{!> charcoal/admin/template/inc.description }}
                </header>
            {{/ showHeader }}

            {{# showActions }}
                <div class="widget-actions">
                    {{# actions }}
                        <a href="{{ url }}">{{ label }}</a>
                    {{/ actions }}
                </div>
            {{/ showActions }}

            {{> *template }}

        </div>

        {{# dashboardLayout }}
           {{> charcoal/admin/widget/layout.end }}
        {{/ dashboardLayout }}

    {{/ widgets }}

</div>
