<section class="card w-100">
    <header class="card-header">
        <h3 class="card-title mb-0">{{# _t }}All Caches{{/ _t }}</h3>
    </header>
    <div class="card-body">
        <p>{{# _t }}Clears every cache at once:{{/ _t }}</p>
        <ul>
            {{^ isMemory }}
            <li>{{# _t }}Application cache (pages, objects, metadata and all other items){{/ _t }}</li>
            {{/ isMemory }}
            {{# hasViewCache }}
            <li>{{# _t }}Templates cache (compiled Twig and Mustache templates){{/ _t }}</li>
            {{/ hasViewCache }}
            {{# hasCloudflareCache }}
            <li>{{# _t }}Cloudflare edge cache (all pages and assets){{/ _t }}</li>
            {{/ hasCloudflareCache }}
        </ul>
    </div>
    <footer class="card-footer bg-transparent">
        <button class="btn btn-lg btn-primary" data-clear="cache" data-cache-type="global">
            <i class="fa fa-trash" aria-hidden="true">&nbsp;</i>
            <span class="btn-label">{{# _t }}Clear All Caches{{/ _t }}</span>
        </button>
    </footer>
</section>
