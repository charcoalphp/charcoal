{{!--

    System Info Table Template
    =============

--}}
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Details</th>
        </tr>
    </thead>
    <tbody>
        {{# tableData }}
            <tr>
                <td>{{ label }}</td>
                <td><pre>{{ value }}</pre></td>
            </tr>
        {{/ tableData }}
    </tbody>
</table>
