{{!--
    Form Groups
    ===========

    @used-by charcoal/admin/template/object-form
    @used-by charcoal/admin/template/quick-form
--}}
<div class="c-form-widget_groups{{^ isDisplayModeLang }}{{# isTabbable }} tab-content{{/ isTabbable }}{{/ isDisplayModeLang }}">
    {{# groups }}
        {{^ hidden }}
            {{# formLayout }}
                {{> charcoal/admin/widget/layout.start }}
            {{/ formLayout }}
            <div class="c-form-widget_group{{# ident }} form-group-{{ . }}{{/ ident }}{{# formLayout.cellSpanBy12 }} col-md-{{ . }}{{/ formLayout.cellSpanBy12 }} js-group-tab{{^ isDisplayModeLang }}{{# isTabbable }} tab-pane{{^ isHidden }} active{{/ isHidden }}{{/ isTabbable }}{{/ isDisplayModeLang }}{{^ isTabbable }}{{# isHidden }} hidden{{/ isHidden }}{{/ isTabbable }}"
                id="{{ widgetId }}"
                style="{{# conditionalLogicUnmet }}display:none;{{/ conditionalLogicUnmet }}"
                {{^ isDisplayModeLang }}{{# isTabbable }}
                role="tabpanel"
                aria-labelledby="{{ widgetId }}_tab_{{ident}}"
                {{/ isTabbable }}{{/ isDisplayModeLang }}>

                {{> *template }}
            </div>

            {{# formLayout }}
                {{> charcoal/admin/widget/layout.end }}
            {{/ formLayout }}
        {{/ hidden }}
    {{/ groups }}
</div>